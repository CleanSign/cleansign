# Clean Sign server (Go)
# 로컬 실행: make run (루트). 이 파일을 .env로 복사해 값을 채운다.

PORT=4000
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5433/cleansign?sslmode=disable

# 토큰 서명과 인증코드 해시에 쓰는 비밀값 (16자 이상). 운영에서는 길고 무작위인 값으로 바꾼다
JWT_SECRET=dev-only-secret-change-me-please

# https에서만 쿠키를 보내려면 true (운영)
COOKIE_SECURE=false

# 인증코드 메일 (Gmail이면 smtp.gmail.com / 587 / 앱 비밀번호).
# SMTP_HOST를 비워 두면 메일을 보내지 않고 서버 로그에 코드를 남긴다 (로컬 개발용)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI 분석 서버 (ai-service/)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=        # ai-service의 INTERNAL_TOKEN과 같은 값
AI_SERVICE_TIMEOUT_MS=600000
