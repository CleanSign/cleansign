# Clean Sign web (Next.js)

# Go server address. /api/v1/* requests are forwarded here (rewrites in next.config.ts).
# In a standalone build this is fixed at build time, so pass it to the production image as a build arg (SERVER_URL)
SERVER_URL=http://localhost:4000

# Set to true to send cookies over https only (production). Keep it the same as the server's COOKIE_SECURE
COOKIE_SECURE=false

# Show the overall contract risk score and grade on the result screen. Keep false until #31 (Accurate contract risk grade) is done
SHOW_RISK_SCORE=false
