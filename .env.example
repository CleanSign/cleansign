# Database and Auth Configuration
DATABASE_URL=postgres://postgres:mysecretpassword@localhost:5433/foodie
BETTER_AUTH_SECRET=... # Secret for Better Auth
BETTER_AUTH_URL=http://localhost:3000 # Base URL of the Application

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=yourpassword
SMTP_FROM=from@example.com

# AI Analysis Server (ai-service/)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN= # ai-service의 INTERNAL_TOKEN과 같은 값
AI_SERVICE_TIMEOUT_MS=120000
