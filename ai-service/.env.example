# 모델 계층: ollama(로컬) | mock(오프라인 테스트용 키워드 분류)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
LLM_TIMEOUT_S=60
LLM_CONCURRENCY=1

# 앱 → AI 서버 호출 보호용 공유 토큰 (비우면 검사하지 않음: 로컬 개발 전용)
INTERNAL_TOKEN=

MAX_UPLOAD_MB=10
MOCK_DELAY_S=0  # LLM_PROVIDER=mock일 때 조항당 지연(초), 진행 화면 시험용
