# Model layer: ollama (local) | mock (keyword classification for offline tests)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
LLM_TIMEOUT_S=60
LLM_CONCURRENCY=1

# Shared token protecting app -> AI server calls (if empty, no check is done: local development only)
INTERNAL_TOKEN=

MAX_UPLOAD_MB=10
MOCK_DELAY_S=0  # Per-clause delay in seconds when LLM_PROVIDER=mock, for testing the progress screen
